{
  "name": "nutrequine-pro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mts",
    "build": "node scripts/build-local.mjs",
    "build:client": "node scripts/build-local.mjs --client-only",
    "build:node": "node scripts/build-node.mjs",
    "start": "node dist-node/server/main.mjs",
    "auth:prepare": "node server/admin.mts",
    "db:admin": "node scripts/sqlite-admin.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/local-e2e/*.test.mjs",
    "check": "tsc --noEmit",
    "check:client": "tsc -p client/tsconfig.json",
    "check:node": "tsc -p server/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "check:distribution": "node scripts/check-distribution.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
